@model Business.DTO.CreatePatientDto

@{
    ViewData["Title"] = "Add New Patient";
}

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h3 mb-1 fw-bold text-dark">Add New Patient</h2>
            <p class="text-muted small mb-0">Enter patient personal and contact details to register them in the system.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            ← Back to Patients
        </a>
    </div>

    <!-- Form Content -->
    <form asp-action="Create" method="post" class="bg-white p-4 rounded-3 shadow-sm border-0">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label fw-semibold text-secondary small"></label>
                <input asp-for="FirstName" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="First Name" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LastName" class="form-label fw-semibold text-secondary small"></label>
                <input asp-for="LastName" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="Last Name" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="AadhaarId" class="form-label fw-semibold text-secondary small">Aadhaar ID</label>
                <input asp-for="AadhaarId" class="form-control form-control-lg bg-light border-0 fs-6" maxlength="12" placeholder="12-digit number" />
                <span asp-validation-for="AadhaarId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DateOfBirth" class="form-label fw-semibold text-secondary small">Date of Birth</label>
                <input asp-for="DateOfBirth" type="date" class="form-control form-control-lg bg-light border-0 fs-6" />
                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PhoneN1" class="form-label fw-semibold text-secondary small"></label>
                <input asp-for="PhoneN1" class="form-control form-control-lg bg-light border-0 fs-6" maxlength="10" placeholder="Primary phone number" />
                <span asp-validation-for="PhoneN1" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PhoneN2" class="form-label fw-semibold text-secondary small"></label>
                <input asp-for="PhoneN2" class="form-control form-control-lg bg-light border-0 fs-6" maxlength="10" placeholder="Secondary phone number" />
                <span asp-validation-for="PhoneN2" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="EmergencyPhone" class="form-label fw-semibold text-secondary small"></label>
                <input asp-for="EmergencyPhone" class="form-control form-control-lg bg-light border-0 fs-6" maxlength="10" placeholder="Emergency contact number" />
                <span asp-validation-for="EmergencyPhone" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-semibold text-secondary small"></label>
                <input asp-for="Email" type="email" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="patient@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="HomeAddress" class="form-label fw-semibold text-secondary small"></label>
                <textarea asp-for="HomeAddress" class="form-control bg-light border-0 fs-6" rows="3" placeholder="Enter complete home address"></textarea>
                <span asp-validation-for="HomeAddress" class="text-danger small"></span>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary px-4">Create Patient</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}