@model Business.DTO.PatientDto
@{
    ViewData["Title"] = "Patient Details";
}

<div class="container py-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1 text-primary fw-bold">
                <i class="bi bi-person-vcard me-2"></i>@Model.FirstName @Model.LastName
            </h2>
            <p class="text-muted mb-0">Patient ID: <span class="badge bg-secondary">#@Model.Id</span></p>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                <i class="bi bi-pencil-square me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-person-lines-fill me-2"></i>Personal & Contact Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted mb-1">Full Name</label>
                            <p class="fs-6 text-dark mb-0">@Model.FirstName @(string.IsNullOrEmpty(Model.LastName) ? "-" : Model.LastName)</p>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted mb-1">Date of Birth</label>
                            <p class="fs-6 text-dark mb-0">
                                @Model.DateOfBirth.ToString("dd MMM yyyy")
                            </p>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted mb-1">Aadhaar ID</label>
                            <p class="fs-6 text-dark mb-0">
                                <span class="font-monospace">@Model.AadhaarId</span>
                            </p>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted mb-1">Email Address</label>
                            <p class="fs-6 text-dark mb-0">
                                @if (!string.IsNullOrEmpty(Model.Email))
                                {
                                    <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                                }
                                else
                                {
                                    <span class="text-muted">Not Provided</span>
                                }
                            </p>
                        </div>

                        <hr class="my-3 text-muted" />

                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted mb-1">Primary Phone</label>
                            <p class="fs-6 text-dark mb-0">
                                <i class="bi bi-telephone text-primary me-1"></i>
                                <a href="tel:@Model.PhoneN1" class="text-decoration-none">@Model.PhoneN1</a>
                            </p>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted mb-1">Secondary Phone</label>
                            <p class="fs-6 text-dark mb-0">
                                @if (!string.IsNullOrEmpty(Model.PhoneN2))
                                {
                                    <i class="bi bi-telephone-plus text-secondary me-1"></i>
                                    <a href="tel:@Model.PhoneN2" class="text-decoration-none">@Model.PhoneN2</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </p>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted mb-1">Emergency Contact</label>
                            <p class="fs-6 text-dark mb-0">
                                @if (!string.IsNullOrEmpty(Model.EmergencyPhone))
                                {
                                    <span class="badge bg-danger-subtle text-danger fs-6 px-2 py-1 fw-normal">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.EmergencyPhone
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </p>
                        </div>

                        <hr class="my-3 text-muted" />

                        <div class="col-12">
                            <label class="form-label fw-bold text-muted mb-1">Home Address</label>
                            <p class="fs-6 text-dark mb-0">
                                <i class="bi bi-geo-alt text-danger me-1"></i>
                                @(string.IsNullOrEmpty(Model.HomeAddress) ? "No address recorded" : Model.HomeAddress)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h6 class="card-title mb-0 fw-bold text-secondary">
                        <i class="bi bi-info-circle me-2"></i>System Metadata
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted d-block">Registered On</small>
                        <span class="fw-semibold text-dark">
                            @Model.CreatedAt.ToString("f")
                        </span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body text-center py-4">
                    <i class="bi bi-calendar-plus display-6 text-primary mb-2 d-block"></i>
                    <h6 class="fw-bold">Manage Patient</h6>
                    <p class="text-muted small">Schedule an appointment or view medical records.</p>
                    <button class="btn btn-sm btn-primary" disabled>
                        <i class="bi bi-plus-circle me-1"></i> New Appointment
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>