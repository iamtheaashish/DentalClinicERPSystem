@model Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header & Action Button -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Dashboard</h3>
        <p class="text-muted small mb-0">Welcome back! Here is what's happening at the clinic today.</p>
    </div>
    <div>
        <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> New Appointment
        </a>
    </div>
</div>

<!-- 1. KPI Metric Cards (Responsive Grid) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-primary">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Today's Schedule</span>
                    <h2 class="fw-bold my-1 text-primary">@Model.AppointmentsTodayCount</h2>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                        Scheduled Today
                    </span>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                    <i class="bi bi-calendar-check fs-2"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-warning">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Pending Requests</span>
                    <h2 class="fw-bold my-1 text-warning">@Model.PendingAppointmentsCount</h2>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">
                        Requires Action
                    </span>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                    <i class="bi bi-clock-history fs-2"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-info">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Patients</span>
                    <h2 class="fw-bold my-1 text-info">@Model.TotalPatients</h2>
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill">
                        Registered
                    </span>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                    <i class="bi bi-people fs-2"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. Main Dashboard Content Grid -->
<div class="row g-4">
    <!-- Today's Appointments Table (Main Column) -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-calendar3 me-2 text-primary"></i>Today's Appointments
                </h5>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    View All
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Time</th>
                                <th scope="col">Patient</th>
                                <th scope="col">Doctor</th>
                                <th scope="col">Treatment</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TodayAppointments != null && Model.TodayAppointments.Any())
                            {
                                @foreach (var appointment in Model.TodayAppointments)
                                {
                                    <tr>
                                        <td class="fw-semibold text-nowrap">
                                            <i class="bi bi-clock me-1 text-muted"></i>
                                            @appointment.AppointmentTime.ToString("hh:mm tt")
                                        </td>
                                        <td class="fw-semibold">@appointment.PatientName</td>
                                        <td class="text-muted">@appointment.DoctorName</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @appointment.TreatmentType
                                            </span>
                                        </td>
                                        <td>
                                            @{
                                                var statusBadgeClass = appointment.Status?.ToLower() switch
                                                {
                                                    "confirmed" => "bg-success-subtle text-success border-success-subtle",
                                                    "completed" => "bg-primary-subtle text-primary border-primary-subtle",
                                                    "pending" => "bg-warning-subtle text-warning-emphasis border-warning-subtle",
                                                    "cancelled" => "bg-danger-subtle text-danger border-danger-subtle",
                                                    _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
                                                };
                                            }
                                            <span class="badge border rounded-pill @statusBadgeClass">
                                                @appointment.Status
                                            </span>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.Id" class="btn btn-sm btn-light border me-1" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="Appointments" asp-action="Edit" asp-route-id="@appointment.Id" class="btn btn-sm btn-light border" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                        <span>No appointments scheduled for today.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recently Registered Patients (Sidebar Column) -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-person-lines-fill me-2 text-info"></i>Recently Registered
                </h6>
                <a asp-controller="Patients" asp-action="Index" class="text-decoration-none small">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @if (Model.RecentPatients != null && Model.RecentPatients.Any())
                    {
                        @foreach (var patient in Model.RecentPatients)
                        {
                            <div class="list-group-item d-flex align-items-center justify-content-between py-3 px-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-secondary bg-opacity-10 rounded-circle text-secondary p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-person fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-semibold">@patient.FullName</h6>
                                        <small class="text-muted">
                                            <i class="bi bi-telephone me-1"></i>@patient.PhoneNumber
                                        </small>
                                    </div>
                                </div>
                                <a asp-controller="Patients" asp-action="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-light border rounded-circle" title="Patient File">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="card-body d-flex align-items-center justify-content-center p-4 text-muted small">
                            No recent patients added.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>