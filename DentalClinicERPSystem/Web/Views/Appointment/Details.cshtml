@model Business.DTO.AppointmentDto
@{
    ViewData["Title"] = "Appointment Details";
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0">
                    <i class="bi bi-calendar-check me-2"></i>Appointment Information
                </h5>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted mb-1">Patient</label>
                        <p class="fs-6 text-dark mb-0">
                            <i class="bi bi-person me-1 text-primary"></i>
                            @Model.PatientName
                        </p>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted mb-1">Appointment Type</label>
                        <p class="fs-6 text-dark mb-0">
                            @Model.AppointmentType
                        </p>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted mb-1">Scheduled Date & Time</label>
                        <p class="fs-6 text-dark mb-0">
                            <i class="bi bi-calendar-event me-1 text-primary"></i>
                            @Model.ScheduledDateTime.ToString("dd MMM yyyy, hh:mm tt")
                        </p>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted mb-1">Duration</label>
                        <p class="fs-6 text-dark mb-0">
                            @Model.DurationInMinutes minutes
                        </p>
                    </div>

                    <hr class="my-3 text-muted" />

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted mb-1">Status</label>
                        <p class="mb-0">
                            <span class="badge bg-primary-subtle text-primary fs-6 px-2 py-1">
                                @Model.Status
                            </span>
                        </p>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted mb-1">Dentist</label>
                        <p class="fs-6 text-dark mb-0">
                            @(Model.Dentists?.FirstOrDefault(d => d.Id == Model.DentistId)?.FullName ?? "Not Assigned")
                        </p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ChiefComplaint))
                    {
                        <hr class="my-3 text-muted" />

                        <div class="col-12">
                            <label class="form-label fw-bold text-muted mb-1">Chief Complaint</label>
                            <p class="fs-6 text-dark mb-0">
                                @Model.ChiefComplaint
                            </p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="col-12">
                            <label class="form-label fw-bold text-muted mb-1">Notes</label>
                            <p class="fs-6 text-dark mb-0">
                                @Model.Notes
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light py-3">
                <h6 class="card-title mb-0 fw-bold text-secondary">
                    <i class="bi bi-info-circle me-2"></i>System Metadata
                </h6>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Appointment ID</small>
                    <span class="fw-semibold text-dark">
                        #@Model.Id
                    </span>
                </div>

                <div>
                    <small class="text-muted d-block">Created On</small>
                    <span class="fw-semibold text-dark">
                        @Model.CreatedAt.ToString("f")
                    </span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body text-center py-4">
                <i class="bi bi-calendar2-check display-6 text-primary mb-2 d-block"></i>

                <h6 class="fw-bold">Manage Appointment</h6>

                <p class="text-muted small">
                    Update appointment details or manage its status.
                </p>

                <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                    <i class="bi bi-pencil me-1"></i> Edit Appointment
                </a>
            </div>
        </div>
    </div>
</div>