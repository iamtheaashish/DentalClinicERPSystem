@using DentalClinicERPSystem.Domain.Entities
@model Business.DTO.UpdateAppointmentDto

@{
    ViewData["Title"] = "Update Appointment";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white py-3">
        <h5 class="card-title mb-0">
            <i class="bi bi-calendar2-event me-2"></i>Appointment Information
        </h5>
    </div>

    <div class="card-body p-4">
        <form asp-action="Update" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger mb-4"
                 role="alert"></div>

            <h6 class="text-secondary fw-bold mb-3">
                <i class="bi bi-calendar-event me-2"></i>Schedule
            </h6>

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <label asp-for="ScheduledDateTime"
                           class="form-label fw-semibold"></label>

                    <input asp-for="ScheduledDateTime"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="ScheduledDateTime"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="DurationInMinutes"
                           class="form-label fw-semibold"></label>

                    <input asp-for="DurationInMinutes"
                           type="number"
                           min="1"
                           max="480"
                           class="form-control" />

                    <span asp-validation-for="DurationInMinutes"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">End Time</label>

                    <input type="text"
                           class="form-control bg-light"
                           value="@Model.EndTime.ToString("hh:mm tt")"
                           readonly />
                </div>

            </div>

            <hr class="my-4 text-muted" />

            <h6 class="text-secondary fw-bold mb-3">
                <i class="bi bi-clipboard2-pulse me-2"></i>Appointment Details
            </h6>

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <label asp-for="AppointmentType"
                           class="form-label fw-semibold"></label>

                    <input asp-for="AppointmentType"
                           class="form-control"
                           placeholder="e.g. Routine Checkup" />

                    <span asp-validation-for="AppointmentType"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Status"
                           class="form-label fw-semibold"></label>

                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<AppointmentStatus>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="ChiefComplaint"
                           class="form-label fw-semibold"></label>

                    <textarea asp-for="ChiefComplaint"
                              class="form-control"
                              rows="3"
                              placeholder="Describe the patient's chief complaint"></textarea>

                    <span asp-validation-for="ChiefComplaint"
                          class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Notes"
                           class="form-label fw-semibold"></label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="3"
                              placeholder="Enter internal appointment notes"></textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger small"></span>
                </div>

            </div>

            <hr class="my-4 text-muted" />

            <h6 class="text-secondary fw-bold mb-3">
                <i class="bi bi-person-badge me-2"></i>Dentist Assignment
            </h6>

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <label asp-for="DentistId"
                           class="form-label fw-semibold"></label>

                    <input asp-for="DentistId"
                           class="form-control"
                           placeholder="Enter dentist ID (optional)" />

                    <span asp-validation-for="DentistId"
                          class="text-danger small"></span>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Index"
                   class="btn btn-light border px-4">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i> Save Changes
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}