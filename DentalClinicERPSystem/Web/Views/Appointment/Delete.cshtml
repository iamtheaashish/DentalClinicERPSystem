@model Business.DTO.AppointmentDto

@{
    ViewData["Title"] = "Delete Patient";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white text-center py-3">
                    <i class="bi bi-exclamation-triangle-fill fs-1 d-block mb-1"></i>
                    <h4 class="fw-bold mb-0">Confirm Deletion</h4>
                </div>

                <div class="card-body p-4 text-center">
                    <p class="text-muted mb-3">Are you sure you want to delete this appointment? This action cannot be undone.</p>

                    <div class="p-3 bg-light rounded border mb-4">
                        <span class="text-muted small d-block">Patient Name</span>
                        <h5 class="fw-bold text-dark mb-0">@Model.PatientId @Model.PatientName</h5>
                        <small class="text-secondary font-monospace">(ID: #@Model.Id)</small>
                    </div>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="bi bi-trash me-1"></i> Yes, Delete Appointment
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>