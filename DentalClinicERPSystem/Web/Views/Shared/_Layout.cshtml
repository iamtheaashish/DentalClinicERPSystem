<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dental Clinic ERP</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
</head>
<body class="vh-100 overflow-hidden">

    <div class="d-flex vh-100 overflow-hidden" id="wrapper">

        <!-- Sidebar (Fixed) -->
        <aside class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark h-100" style="width: 250px;">

            <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none px-2">
                <i class="bi bi-hospital fs-3 me-2 text-primary"></i>
                <span class="fs-4 fw-bold">Dental Clinic</span>
            </a>

            <hr class="my-3">

            <ul class="nav nav-pills flex-column mb-2">
                <li class="nav-item">
                    <a class="nav-link text-white active d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2 fs-5"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
            </ul>

            <hr class="my-2">

            <ul class="nav nav-pills flex-column mb-auto gap-1">
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2" asp-controller="Patient" asp-action="Index">
                        <i class="bi bi-people fs-5"></i>
                        <span>Patients</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2" asp-controller="Appointments" asp-action="Index">
                        <i class="bi bi-calendar-event fs-5"></i>
                        <span>Appointments</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2" asp-controller="Billing" asp-action="Index">
                        <i class="bi bi-receipt fs-5"></i>
                        <span>Invoice</span>
                    </a>
                </li>
            </ul>

            <div class="pt-3 border-top mt-auto">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-right fs-5"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>

        </aside>

        <!-- Right Content Area -->
        <div id="page-content-wrapper" class="d-flex flex-column flex-grow-1 overflow-hidden">

            <!-- Top Header (Fixed) -->
            <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4 py-2 shadow-sm flex-shrink-0">
                <div class="container-fluid p-0 d-flex justify-content-end align-items-center">
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle gap-2" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-4 text-primary"></i>
                            <span class="fw-semibold">Admin</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>My Profile</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Scrollable View Body -->
            <main class="container-fluid p-4 flex-grow-1 overflow-auto bg-light">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>